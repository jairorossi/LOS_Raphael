<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <!-- Repositorios OFICIAIS de Device Tree e Kernel do LineageOS 19.1 -->
  <project name="LineageOS/android_device_xiaomi_raphael" path="device/xiaomi/raphael" remote="github" revision="lineage-19.1" />
  <project name="LineageOS/android_device_xiaomi_sm8150-common" path="device/xiaomi/sm8150-common" remote="github" revision="lineage-19.1" />
  <!-- Kernel na lineage-22.2: a branch lineage-19.1 deste repo foi reescrita e so tem vayu (sem raphael.config, sem dts do raphael) -->
  <project name="LineageOS/android_kernel_xiaomi_sm8150" path="kernel/xiaomi/sm8150" remote="github" revision="lineage-22.2" />
  
  <!-- Blobs proprietarios oficiais TheMuppets para lineage-19.1 (Android 12L).
       Repo monolitico com todos os devices Xiaomi; o GitHub foi derrubado por DMCA,
       o espelho vivo e o GitLab. ATENCAO: clone completo e pesado (~dezenas de GB);
       em build local usamos git sparse-checkout so de raphael/ e sm8150-common/. -->
  <remote name="muppets-gitlab" fetch="https://gitlab.com/the-muppets/" />
  <project name="proprietary_vendor_xiaomi" path="vendor/xiaomi" remote="muppets-gitlab" revision="lineage-19.1" clone-depth="1" />

  <!-- Dependencia de hardware comum da Xiaomi -->
  <project name="LineageOS/android_hardware_xiaomi" path="hardware/xiaomi" remote="github" revision="lineage-19.1" />
</manifest>
